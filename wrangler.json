{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semanticlab-website",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "SL_DEPLOY_ENV": "production",
    "SL_FEATURE_GALAXY_MOTION": "false",
    "SL_INDEXING_ALLOWED": "true",
    "SL_ANALYTICS_ENABLED": "true"
  }
}
